{
  "name": "ijwi-hack-day",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @ijwi/frontend dev",
    "dev:backend": "pnpm --filter @ijwi/backend dev",
    "build": "pnpm --filter @ijwi/frontend build",
    "check": "pnpm --filter @ijwi/frontend check",
    "test": "pnpm --filter @ijwi/backend test && pnpm --filter @ijwi/frontend test",
    "deploy:frontend": "wrangler deploy --config frontend/wrangler.jsonc",
    "deploy:backend": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
