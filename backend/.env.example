# Local development only. Production uses backend Worker secrets.
# Deployed backend uses its AI binding; local Node development uses REST credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GEMMA_MODEL=@cf/google/gemma-4-26b-a4b-it
# Google fallback, used when Cloudflare is unavailable or not configured.
GOOGLE_API_KEY=
GOOGLE_GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional cross-origin frontend URLs; same-origin service-binding requests need none.
ALLOWED_ORIGINS=
PORT=8787
# Adaption is reserved; FastDRS settings are used only by /screen.
ADAPTION_API_KEY=
FASTDRS_API_URL=
FASTDRS_API_TOKEN=

# New /screen feature: API base URL, shared inference token, result-signing secret.
# FASTDRS_API_URL=https://screen.your-domain.example (no /v1/screen suffix).
# Use a random secret of at least 32 characters; only the backend Worker needs this.
SCREENING_CONTEXT_SECRET=
